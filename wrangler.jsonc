{
  "name": "ai-stocks",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",

  "assets": {
    "directory": "./public",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "kv_namespaces": [
    {
      "binding": "ANALYSIS_CACHE",
      "id": "2cc8de0a312d4391a1902edd40114963"
    }
  ],

  "routes": [
    {
      "pattern": "monetarium.ardacolaker.com",
      "custom_domain": true
    }
  ]
}
